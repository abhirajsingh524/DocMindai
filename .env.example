# ==============================================================================
# DocMind AI — Environment Configuration Example
# ==============================================================================
# Instructions:
# 1. Copy this file to .env: `cp .env.example .env` (or on Windows: `copy .env.example .env`)
# 2. Add your APINEX_API_KEY below. Never commit your real key to GitHub!
# ==============================================================================

# LLM Provider Configuration (APINEX)
LLM_PROVIDER=apinex
APINEX_BASE_URL=https://api.apinex.bond/v1
APINEX_MODEL=free/glm-5.3-flash
# Enter your APINEX API Key here:
APINEX_API_KEY=

# Embedding Provider Configuration
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Backend Application Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database & Storage
DATABASE_URL=sqlite+aiosqlite:///./docmind.db
STORAGE_DIR=./data/storage
INDEX_DIR=./data/indices

# Security & Sessions
SECRET_KEY=change-this-in-production-docmind-secret-key-32bytes
ACCESS_TOKEN_EXPIRE_MINUTES=1440
